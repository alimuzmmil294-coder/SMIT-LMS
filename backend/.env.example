# ==========================================
# Backend Environment Configuration Template
# Copy this file to .env and adjust values as needed
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Required)
# Use your MongoDB Atlas connection string or local MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0

# JWT Authentication (Required)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# Allowed Client Origin (for CORS, comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Admin Seed Credentials (used by 'npm run seed:admin', min 8 chars password)
ADMIN_NAME=Bootcamp Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
